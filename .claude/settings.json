{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bd hook session-start --harness claude"
          },
          {
            "type": "command",
            "command": "bd prime"
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bd hook subagent-start || true"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(bd *)",
            "command": "bd hook pre-tool-use || true"
          }
        ]
      }
    ]
  }
}
