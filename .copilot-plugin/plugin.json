{
  "name": "bd",
  "description": "Task tracking for coding agents: dependency-aware ready work, leased claims, and durable memory, on SQLite.",
  "version": "0.1.0",
  "author": {
    "name": "quanghle",
    "url": "https://github.com/quanghle"
  },
  "repository": "https://github.com/quanghle/bd-sync",
  "license": "MIT",
  "homepage": "https://github.com/quanghle/bd-sync",
  "keywords": [
    "issue-tracker",
    "task-management",
    "ai-workflow",
    "agent-memory"
  ],
  "hooks": {
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bd prime"
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bd prime"
          }
        ]
      }
    ]
  }
}
